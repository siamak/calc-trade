# ─── Umami Analytics ──────────────────────────────────────────────────────────
# Privacy-first, GDPR-friendly aggregate product metrics.
#
# Self-hosted:
#   NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance.example.com/script.js
#
# Umami Cloud (umami.is):
#   NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
#
# Leave both variables empty to disable Umami entirely (the script tag is
# conditionally rendered and will not be injected).
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id-here
