# Umami Analytics
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here
# Optional: comma-separated domains to track (skips localhost / previews)
NEXT_PUBLIC_UMAMI_DOMAINS=calc.siamak.pro
# Optional: prefix every tracked path ("/en/" → "/calc/en/") when sharing a
# Umami website with another site
NEXT_PUBLIC_UMAMI_PATH_PREFIX=/calc

# Get your credentials from:
# 1. Self-host Umami (https://umami.is/docs/install) or use Umami Cloud
# 2. Add your website in the dashboard
# 3. Copy the tracking script URL and website ID
